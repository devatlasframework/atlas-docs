{
  // Prose-friendly defaults: our docs use long lines, tables, and inline HTML.
  "MD013": false, // line length
  "MD033": false, // inline HTML
  "MD041": false, // first line need not be a top-level heading
  "MD024": { "siblings_only": true }, // repeated headings ok across sections
  "MD060": false // table pipe padding — prettier owns table style
}
